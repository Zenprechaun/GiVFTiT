# Copy to .env for local development. Never commit .env.

DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave empty for SQLite. Production: postgres://user:password@host:5432/dbname
DATABASE_URL=

SITE_NAME=GiVFTiT
SITE_URL=http://localhost:8000

# "fake" = no real charges (development only). "stripe" = real payments.
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Emails print to the terminal by default. For real email:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=GiVFTiT <no-reply@yourdomain.com>

# Business rules (defaults shown)
# CHEERING_FEE_RATE=0.10
# VENDOR_FEE_RATE=0.05
# GIFT_EXPIRY_DAYS=364
# MAX_TOPUP_CENTS=50000
